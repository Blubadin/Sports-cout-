# Classic remains the safe default during Coach Pilot preparation.
VITE_ENABLE_WORKSTATION=false

# AI service: maximum bytes in each uploaded video (default 8 GiB).
# Set this in the Python service environment; server.py does not load .env files.
# PowerShell: $env:SPORTSCOUT_AI_MAX_UPLOAD_BYTES = '8589934592'
SPORTSCOUT_AI_MAX_UPLOAD_BYTES=8589934592

# Optional VERIFIED local shuttle artifact (never bundled/downloaded automatically).
# Export these in the Python process environment; .env is not auto-loaded.
# SHUTTLE_ENABLED=true
# SHUTTLE_PROVIDER=rallylens_tracknet
# SHUTTLE_MODEL_PATH=<absolute path to audited rallylens-shuttle-tracknet.pth>
# Adapter defaults: 9 frames, 512x288, pytorch/fp32/cpu; requires frameStride=1.
# This is not a network security configuration. Do not expose the service to LAN.
