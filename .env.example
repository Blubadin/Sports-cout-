# Production builds require authentication and always disable exports.
# Copy these public settings to .env.pilot (ignored) or Vercel environment vars.
VITE_SPORTSCOUT_RELEASE_CHANNEL=pilot
VITE_ENABLE_WORKSTATION=true
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local AI pilot distribution only. Never put this device secret in VITE_* vars.
# SPORTSCOUT_RELEASE_CHANNEL=pilot
# SPORTSCOUT_AI_AUTH_TOKEN=PER_DEVICE_SECRET

# Normal localhost development leaves this empty; hosted Local AI pairing is a
# separate phase. Do not use a VITE variable for any bearer/device secret.
VITE_SPORTSCOUT_AI_ENDPOINT=

# Python service settings are exported in its process environment, not loaded
# automatically from Vite .env files. Existing local upload/model options:
SPORTSCOUT_AI_MAX_UPLOAD_BYTES=8589934592
# SHUTTLE_ENABLED=true
# SHUTTLE_PROVIDER=rallylens_tracknet
# SHUTTLE_MODEL_PATH=<absolute path to audited rallylens-shuttle-tracknet.pth>
# Explicit installation: npm run setup:shuttle verifies the audited artifact.
# The existing adapter requires frameStride=1 (9 frames, 512x288, pytorch/fp32).
# npm run start:local recognizes .local-models/rallylens-shuttle-tracknet.pth.
