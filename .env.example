# Classic remains the safe default during Coach Pilot preparation.
VITE_ENABLE_WORKSTATION=false

# AI service: maximum bytes in each uploaded video (default 8 GiB).
# Set this in the Python service environment; server.py does not load .env files.
# PowerShell: $env:SPORTSCOUT_AI_MAX_UPLOAD_BYTES = '8589934592'
SPORTSCOUT_AI_MAX_UPLOAD_BYTES=8589934592
